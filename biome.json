{
  "files": {
    "includes": [
      "**",
      "!**/docs",
      // Connecteurs PHP (PrestaShop/WooCommerce) exclus nommément — PAS de
      // blanket "!**/connectors" : connectors/shopify est un paquet TS
      // workspace (@factelec/connector-shopify) que biome DOIT couvrir. Un
      // "!**/connectors" suivi d'un ré-include ne fonctionne pas ici (motif
      // gitignore : un dossier exclu n'est plus descendu, un pattern positif
      // plus spécifique ne le fait pas réapparaître — vérifié empiriquement).
      "!connectors/prestashop",
      "!connectors/woocommerce",
      "!**/dist",
      "!**/.next",
      "!**/coverage",
      "!**/*.sef.json",
      "!**/next-env.d.ts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" },
    "parser": { "unsafeParameterDecoratorsEnabled": true }
  },
  "overrides": [
    {
      "includes": ["**/tests/**"],
      "linter": {
        "rules": {
          "style": { "noNonNullAssertion": "off" },
          "suspicious": { "noDocumentCookie": "off" }
        }
      }
    }
  ]
}
